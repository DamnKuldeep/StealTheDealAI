# Copy this file to config/.env and fill in real values.
# config/.env is gitignored - never commit real keys.

# NVIDIA NIM API key - get one free at https://build.nvidia.com
# Powers the Scanner, Preprocessor, and RAG/Frontier agents (all share one 40 req/min
# free-tier budget, enforced by agents/rate_limiter.py).
NIM_API_KEY=

# Telegram bot for deal notifications - create a bot via @BotFather on Telegram to get
# TELEGRAM_BOT_TOKEN, then message the bot and check
# https://api.telegram.org/bot<token>/getUpdates to find your TELEGRAM_CHAT_ID.
# Optional: if left blank, notifications just print to the console instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hugging Face WRITE token from https://huggingface.co/settings/tokens.
# Needed to push your fine-tuned adapter from the Kaggle notebook (03_finetune_llm.ipynb)
# and for the Modal deployment to pull the gated meta-llama/Llama-3.2-3B base model.
# Only required if you're doing the fine-tuning / Specialist agent steps (see SETUP.md).
HF_TOKEN=
